{
  "name": "statecarry",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "format": "oxfmt --write .",
    "format:check": "tsx scripts/run-turbo.ts task:format:check",
    "lint": "tsx scripts/run-turbo.ts task:lint",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsx scripts/run-turbo.ts task:typecheck",
    "check:boundaries": "tsx scripts/run-turbo.ts task:check:boundaries",
    "check": "tsx scripts/run-turbo.ts task:typecheck task:check:boundaries",
    "test": "vitest run",
    "build:artifacts": "tsx scripts/build.ts",
    "build": "tsx scripts/run-turbo.ts task:build:artifacts",
    "verify": "tsx scripts/run-turbo.ts task:format:check task:lint task:typecheck task:check:boundaries task:test task:build:artifacts",
    "verify:fresh": "tsx scripts/run-turbo.ts --fresh task:format:check task:lint task:typecheck task:check:boundaries task:test task:build:artifacts",
    "task:format:check": "oxfmt --check .",
    "task:lint": "oxlint .",
    "task:typecheck": "tsc --noEmit",
    "task:check:boundaries": "tsx scripts/check-boundaries.ts",
    "task:test": "vitest run",
    "task:build:artifacts": "tsx scripts/build.ts",
    "desktop:prepare": "electrobun prepare",
    "desktop:config": "electrobun config --env=dev",
    "desktop:config:stable": "electrobun config --env=stable",
    "desktop:dev": "electrobun dev --env=dev --watch",
    "desktop:build": "electrobun build --env=dev",
    "desktop:build:stable": "electrobun build --env=stable",
    "landing:dev": "vite --config apps/landing/vite.config.ts",
    "landing:build": "vite build --config apps/landing/vite.config.ts",
    "start": "node dist/server.mjs",
    "verify:connection": "node dist/verify-connection.mjs",
    "package:local": "tsx scripts/package-local.ts"
  },
  "devDependencies": {
    "@statecarry/contracts": "workspace:*",
    "@statecarry/core": "workspace:*",
    "@statecarry/presentation": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electrobun": "2.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "turbo": "2.10.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
